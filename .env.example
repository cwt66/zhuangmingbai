# 装明白 · 环境变量样例（复制为 .env，不要把真实 Key 提交进仓库）
# 最小可跑：什么都不配也能跑——引擎零依赖，数据库退 SQLite，缓存退进程内。
# 云上完整体：配 DATABASE_URL + REDIS_URL + MAAS_API_KEY，/health 会逐项显示状态。

# ---------- 数据（RDS PostgreSQL） ----------
# 不配则用 data/state.db（SQLite）。配了但连不上会自动降级，并在 /health 写 degraded。
# DATABASE_URL=postgresql://zmb:change-me@127.0.0.1:5432/zmb

# ---------- 缓存 / 限流 / 任务状态（DCS Redis） ----------
# 不配则用进程内缓存；公网多副本时务必配。
# REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT=60

# ---------- 表达层（ModelArts Studio / MaaS） ----------
# 不配则报告里的「解读」由确定性模板生成，并明确标注来源。
# MAAS_API_KEY=
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_TEXT_MODEL=DeepSeek-V3
LLM_ENABLED=1

# ---------- 感知层 ----------
# maas（视觉模型，照片首选）/ ocr_table（华为云表格识别）/ file（CSV/XLSX/PDF）/ mock（仅测试）
PERCEPTION_PROVIDER=maas
# HW_ACCESS_KEY=
# HW_SECRET_KEY=
# HW_REGION=cn-north-4
# HW_PROJECT_ID=

# ---------- 应用 ----------
PORT=8000
# 生产环境建议打开：反向代理后信任 X-Forwarded-For 由 Nginx 设置
