{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "装修报价单解析结果",
  "type": "object",
  "required": ["doc", "rows"],
  "properties": {
    "doc": {
      "type": "object",
      "properties": {
        "city": {"type": ["string", "null"]},
        "area": {"type": ["number", "null"]},
        "scene": {"enum": ["old_house", "new_house", null]},
        "company": {"type": ["string", "null"]},
        "page": {"type": "integer", "minimum": 1}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["no", "name", "unit", "qty", "price", "amount", "confidence"],
        "properties": {
          "no": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "spec": {"type": "string"},
          "unit": {"enum": ["项", "㎡", "m", "樘", "块", "根", "个", "位", "套"]},
          "qty": {"type": ["number", "null"], "minimum": 0},
          "price": {"type": ["number", "null"], "minimum": 0},
          "amount": {"type": ["number", "null"], "minimum": 0},
          "note": {"type": "string"},
          "confidence": {
            "type": "object",
            "required": ["name", "spec", "unit", "qty", "price", "amount"],
            "properties": {
              "name": {"type": "number", "minimum": 0, "maximum": 1},
              "spec": {"type": "number", "minimum": 0, "maximum": 1},
              "unit": {"type": "number", "minimum": 0, "maximum": 1},
              "qty": {"type": "number", "minimum": 0, "maximum": 1},
              "price": {"type": "number", "minimum": 0, "maximum": 1},
              "amount": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "page_notes": {"type": "array", "items": {"type": "string"}}
  }
}
